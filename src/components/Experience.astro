---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/experience';

const showPlaceholders = import.meta.env.DEV;
---

<section id="experience" class="scroll-mt-20 border-y border-line bg-surface-2/40 py-20" aria-labelledby="experience-title">
  <div class="container-page">
    <SectionHeading id="experience" eyebrow="Experience" title="Where I've worked" />

    <ol class="relative space-y-10 border-l border-line pl-8 sm:ml-2">
      {
        experience.map((job) => (
          <li class="reveal relative">
            <span
              class="absolute top-1 -left-[2.6rem] grid size-8 place-items-center rounded-full border border-line bg-surface text-accent-text"
              aria-hidden="true"
            >
              <Icon name="briefcase" size={15} />
            </span>

            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="text-lg font-semibold text-fg">
                {job.role}
                <span class="text-muted"> · </span>
                {job.companyUrl ? (
                  <a href={job.companyUrl} target="_blank" rel="noopener" class="text-accent-text hover:underline">
                    {job.company}
                  </a>
                ) : (
                  <span class="text-accent-text">{job.company}</span>
                )}
                {showPlaceholders && job.placeholder && (
                  <span class="ml-2 rounded bg-amber-100 px-1.5 py-0.5 align-middle font-mono text-[10px] font-medium text-amber-800 uppercase">
                    placeholder
                  </span>
                )}
              </h3>
              <p class="shrink-0 font-mono text-xs text-subtle">
                <time>{job.start}</time> – <time>{job.end}</time>
              </p>
            </div>
            <p class="mt-0.5 text-sm text-subtle">{job.location}</p>

            {job.summary && <p class="mt-3 text-muted">{job.summary}</p>}

            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-muted marker:text-subtle">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>

            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Technologies">
              {job.tech.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
