---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';
---

<section id="contact" class="container-page scroll-mt-20 pt-20" aria-labelledby="contact-title">
  <div class="reveal card contact-card relative overflow-hidden px-6 py-12 text-center sm:px-12 sm:py-16">
    <p class="font-mono text-xs font-medium tracking-widest text-accent-text uppercase">Contact</p>
    <h2 id="contact-title" class="mt-2 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Let's talk</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
      I'm looking for software engineering roles and I'm always happy to talk about systems, developer tools or a project
      you're working on. Email is the quickest way to reach me.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={`mailto:${site.email}`} class="btn btn-primary">
        <Icon name="mail" size={16} /> Email me
      </a>
      <button type="button" class="btn btn-ghost font-mono" data-copy={site.email} hidden>
        <span data-copy-icon><Icon name="copy" size={16} /></span>
        <span data-copy-done class="hidden text-ok"><Icon name="check" size={16} /></span>
        <span data-copy-label>{site.email}</span>
      </button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

    <SocialLinks class="mt-8 justify-center" />
  </div>
</section>

<style>
  .contact-card {
    background:
      radial-gradient(40rem 16rem at 50% -20%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      var(--surface);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (btn && navigator.clipboard) {
    btn.hidden = false;
    const status = document.querySelector<HTMLElement>('[data-copy-status]')!;
    const icon = btn.querySelector('[data-copy-icon]')!;
    const done = btn.querySelector('[data-copy-done]')!;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        icon.classList.add('hidden');
        done.classList.remove('hidden');
        status.textContent = 'Email address copied to clipboard';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          icon.classList.remove('hidden');
          done.classList.add('hidden');
          status.textContent = '';
        }, 2000);
      } catch {
        window.location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  }
</script>
