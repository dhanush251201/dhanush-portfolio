---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/skills';
---

<section id="skills" class="container-page scroll-mt-20 py-20" aria-labelledby="skills-title">
  <SectionHeading id="skills" eyebrow="Skills" title="What I work with" />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((g) => (
        <div class="reveal card p-5">
          <h3 class="text-sm font-semibold text-fg">{g.group}</h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {g.items.map((s) => (
              <li class="chip">{s}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
