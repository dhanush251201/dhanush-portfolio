---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';

interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28">
    {
      site.availability && (
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok opacity-60 motion-reduce:hidden" />
            <span class="relative inline-flex size-2 rounded-full bg-ok" />
          </span>
          {site.availability}
        </p>
      )
    }

    <h1 id="hero-title" class="mt-6 max-w-3xl font-semibold tracking-tight text-balance text-fg">
      <span class="block text-4xl sm:text-6xl">Hi, I'm {site.shortName}.</span>
      <span class="mt-3 block text-2xl leading-snug font-medium text-muted sm:text-4xl">{site.headline}</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{site.pitch}</p>

    <p class="mt-4 flex items-center gap-1.5 text-sm text-subtle">
      <Icon name="pin" size={15} />
      {site.location}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="#projects" class="btn btn-primary">
        View my work <Icon name="arrow-right" size={16} />
      </a>
      <a href={site.resume} class="btn btn-ghost" target="_blank" rel="noopener">
        <Icon name="download" size={16} /> Resume
      </a>
      <SocialLinks class="sm:ml-2" />
    </div>

    <dl class="mt-16 grid max-w-2xl grid-cols-3 gap-6 border-t border-line pt-8">
      {
        stats.map((s) => (
          <div>
            <dt class="text-sm text-subtle">{s.label}</dt>
            <dd class="text-2xl font-semibold tracking-tight text-fg">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  dl > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
  }
  .hero-bg {
    background:
      radial-gradient(60rem 30rem at 85% -10%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      radial-gradient(40rem 20rem at -10% 10%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%);
    mask-image: linear-gradient(to bottom, black 60%, transparent);
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.45;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 20%, black, transparent 75%);
  }
</style>
