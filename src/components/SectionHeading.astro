---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
}
const { id, eyebrow, title, intro } = Astro.props;
---

<div class="mb-10 max-w-2xl">
  <p class="font-mono text-xs font-medium tracking-widest text-accent-text uppercase">{eyebrow}</p>
  <h2 id={`${id}-title`} class="mt-2 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{title}</h2>
  {intro && <p class="mt-3 text-lg text-muted">{intro}</p>}
</div>
