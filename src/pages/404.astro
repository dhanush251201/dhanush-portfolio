---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="container-page grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="font-mono text-sm text-accent-text">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-fg sm:text-5xl">This page took a cold start… and never came back.</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-muted">The link may be old, or the page may have moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={url('/')} class="btn btn-primary"><Icon name="arrow-left" size={16} /> Back home</a>
        <a href={url('/#projects')} class="btn btn-ghost">See projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
